# Variables de entorno para el generador de texto líquido.
# Copia este archivo a `.env` y ajusta los valores según tus necesidades.

# Ruta al archivo de configuración JSON. Si se omite, se usa el incluido por defecto.
#LIQUID_CONFIG_PATH=src/liquid_config.json

# Directorio de salida para las imágenes renderizadas.
#LIQUID_OUTPUT_DIR=output

# Nombre del preset a renderizar automáticamente cuando no se pasa por CLI.
#LIQUID_PRESET=LIQUID_GOLD
